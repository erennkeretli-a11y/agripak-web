---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, langs, type Lang, type Paths } from '../i18n/ui';
import { u } from '../lib/url';
interface Props { lang: Lang; title?: string; description?: string; paths: Paths; current?: string; ogImage?: string }
const { lang, title, description, paths, current, ogImage } = Astro.props;
const fullTitle = title ? `${title} | AgriPak Kimya` : t(lang, 'meta.title');
const desc = description ?? t(lang, 'meta.desc');
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = site + Astro.url.pathname;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'AgriPak Kimya A.Ş.',
  url: site || 'https://agripak.pro',
  logo: site + u('img/brand/agripak-logo-a.png'),
  email: 'sales@agripak.pro',
  telephone: '+905306337527',
  address: { '@type': 'PostalAddress', streetAddress: 'Güzeloba Mah. Çağlayangil Cad. No: 3B', addressLocality: 'Muratpaşa', addressRegion: 'Antalya', addressCountry: 'TR' },
};
---
<!doctype html>
<html lang={lang}>
  <script is:inline>document.documentElement.classList.add("js");</script>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#15323a" />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => (<link rel="alternate" hreflang={l} href={site + u(paths[l])} />))}
    <link rel="alternate" hreflang="x-default" href={site + u(paths.tr)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={{ tr: 'tr_TR', en: 'en_US', ru: 'ru_RU' }[lang]} />
    <meta property="og:image" content={site + u(ogImage ?? `img/og/og-${lang}.jpg`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AgriPak Kimya · iGrow" />
    <meta property="og:site_name" content="AgriPak Kimya" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={site + u(ogImage ?? `img/og/og-${lang}.jpg`)} />
    <link rel="preload" href={u('fonts/manrope-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={u('fonts/manrope-latin-ext.woff2')} as="font" type="font/woff2" crossorigin />
    {lang === 'ru' && <link rel="preload" href={u('fonts/manrope-cyrillic.woff2')} as="font" type="font/woff2" crossorigin />}
    <style set:html={`
      @font-face{font-family:'Manrope';font-style:normal;font-weight:300 800;font-display:swap;src:url('${u('fonts/manrope-latin-ext.woff2')}') format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C4,U+2113,U+2C60-2C7F,U+A720-A7FF}
      @font-face{font-family:'Manrope';font-style:normal;font-weight:300 800;font-display:swap;src:url('${u('fonts/manrope-latin.woff2')}') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
      @font-face{font-family:'Manrope';font-style:normal;font-weight:300 800;font-display:swap;src:url('${u('fonts/manrope-cyrillic.woff2')}') format('woff2');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
      @font-face{font-family:'Manrope';font-style:normal;font-weight:300 800;font-display:swap;src:url('${u('fonts/manrope-cyrillic-ext.woff2')}') format('woff2');unicode-range:U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F}
      @font-face{font-family:'Manrope Fallback';src:local('Arial');size-adjust:104%;ascent-override:95%;descent-override:25%;line-gap-override:0%}
    `} />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
  </head>
  <body>
    <Header lang={lang} paths={paths} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Reveal on scroll
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });
      document.querySelectorAll('.reveal, .reveal-scale, .text-reveal').forEach((el) => io.observe(el));



      // Mobile menu
      const btn = document.querySelector<HTMLButtonElement>('[data-menu]');
      const nav = document.getElementById('mobile-nav');
      const desktopMenu = matchMedia('(min-width: 80rem)');
      if (btn && nav) {
        const setMenu = (open: boolean) => { nav.hidden = !open; btn.setAttribute('aria-expanded', String(open)); };
        btn.addEventListener('click', () => setMenu(nav.hidden));
        nav.addEventListener('click', (event) => { if (event.target instanceof Element && event.target.closest('a')) setMenu(false); });
        addEventListener('keydown', (event) => { if (event.key === 'Escape' && !nav.hidden) { setMenu(false); btn.focus(); } });
        desktopMenu.addEventListener('change', () => setMenu(false));
      }
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.remove('js');

      // Header tint after scroll
      const header = document.querySelector('.site-header') as HTMLElement | null;
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 24);
      onScroll(); addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>
