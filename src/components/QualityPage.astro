---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { t, route, routePaths, type Lang } from '../i18n/ui';
import { u } from '../lib/url';
interface Props { lang: Lang }
const { lang } = Astro.props;
const paths = routePaths('quality');
const content = {
  tr: {
    title: 'Kalite ve Tescil',
    lead: 'Türkiye pazarına hazırlanan ürünler için uygulanacak lisans ve tescil koşulları, ilgili ürünün mevzuat kapsamına göre değerlendirilir. Bu sayfada belge hazırlığının güncel aşamasını paylaşıyoruz.',
    steps: [
      ['Lisans', 'Lisans şirket adına, tescil belgeleri ürün bazında düzenlenir. Geçerlilik ve yenileme koşulları ilgili mevzuata tabidir.'],
      ['Numune ve analiz', 'Gerekli numuneler ve analizler ilgili ürünün tescil prosedürü kapsamında belirlenir.'],
      ['Tescil ve etiket', 'Tescil tamamlandığında sitedeki bilgiler onaylı Türkçe etiketle uyumlu hâle getirilir.'],
      ['İthalat kontrolleri', 'İthalatta mevzuatın öngördüğü belge ve ürün kontrol prosedürleri uygulanır.'],
    ],
    h2: 'Belgeler',
    docs: ['Ligno OÜ analiz sertifikası (COA), parti bazında', 'Teknik belge (TDS) ve güvenlik bilgi formu (SDS), ürün bazında', 'Üreticinin ürün bazında organik tarımda kullanılabilirlik belgesi, mevcutsa', 'Bakanlık tescil belgesi ve onaylı etiket, tescil tamamlandıkça', 'Antalya Ticaret ve Sanayi Odası faaliyet belgesi ve vergi levhası'],
    h3: 'Ürün bilgilerinin kaynağı',
    p3: 'Sitedeki ürün bilgileri üretici belgelerine dayanır. Türkiye’deki ürün sınıfı ve kullanım beyanları, tescil sürecinde kesinleşen belgelere göre güncellenecektir.',
    status: 'Güncel durum',
    statusD: '15 Ekim 2026 itibarıyla şirketin lisans işlemleri ile iGrow Revive’ın kuru ve sıvı formlarının tesciline yönelik hazırlıklar devam etmektedir. Belge numaraları alındığında bu sayfada yayımlanacaktır.',
  },
  en: {
    title: 'Quality and Registration',
    lead: 'Licensing and registration requirements for products being prepared for the Turkish market are assessed under the legislation applicable to each product. This page explains the current stage of document preparation.',
    steps: [
      ['Licence', 'Licences are issued to the company, while registration certificates are issued for individual products. Validity and renewal are governed by the applicable legislation.'],
      ['Samples and analysis', 'The samples and analyses required are determined within the registration procedure of the respective product.'],
      ['Registration and label', 'Once registration is complete, the information on this site is aligned with the approved Turkish label.'],
      ['Import controls', 'Document and product control procedures required by legislation are applied at import.'],
    ],
    h2: 'Documents',
    docs: ['Ligno OÜ certificate of analysis (COA), per batch', 'Technical documentation (TDS) and safety data sheet (SDS), per product', 'Manufacturer’s product-specific organic farming certificate, where available', 'Ministry registration certificate and approved Turkish label, once registration is complete', 'Antalya Chamber of Commerce and Industry activity certificate and tax registration document'],
    h3: 'Source of product information',
    p3: 'Product information on this site is based on manufacturer documentation. Product classifications and use claims for Türkiye will be updated in line with the documents finalised during registration.',
    status: 'Current status',
    statusD: 'As of 15 October 2026, preparations are under way for the company’s licensing and the registration of iGrow Revive Dry and Liquid. Document numbers will be published on this page once issued.',
  },
  ru: {
    title: 'Качество и регистрация',
    lead: 'Требования к лицензированию и регистрации продукции для рынка Турции определяются с учётом законодательства, применимого к конкретному продукту. На этой странице мы сообщаем о текущем этапе подготовки документов.',
    steps: [
      ['Лицензия', 'Лицензия оформляется на компанию, а регистрационные документы — на отдельные продукты. Сроки действия и порядок продления определяются применимым законодательством.'],
      ['Образцы и анализ', 'Необходимые образцы и анализы определяются в рамках процедуры регистрации соответствующего продукта.'],
      ['Регистрация и этикетка', 'После завершения регистрации сведения на сайте будут сверены с утверждённой этикеткой на турецком языке.'],
      ['Контроль при импорте', 'При импорте выполняются предусмотренные законодательством процедуры контроля документов и продукции.'],
    ],
    h2: 'Документы',
    docs: ['Сертификат анализа Ligno OÜ (COA), на каждую партию', 'Техническое описание продукта (TDS) и паспорт безопасности (SDS), на каждый продукт', 'Документ производителя, подтверждающий допустимость применения конкретного продукта в органическом земледелии, — при наличии', 'Регистрационное свидетельство Министерства и утверждённая этикетка, по мере завершения регистрации', 'Справка о деятельности компании, выданная Торгово-промышленной палатой Анталии, и документ о налоговой регистрации'],
    h3: 'Источники информации о продукции',
    p3: 'Информация о продукции на сайте основана на документах производителя. Классификация продукции и сведения о её применении в Турции будут обновлены в соответствии с документами, оформленными по итогам регистрации.',
    status: 'Текущий статус',
    statusD: 'По состоянию на 15 октября 2026 года продолжается подготовка к получению лицензий компанией и регистрации сухой и жидкой форм iGrow Revive. Номера документов будут опубликованы после их получения.',
  },
} as const;
const c = content[lang];
---
<Base lang={lang} title={c.title} description={c.lead} paths={paths} current="quality">
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={t(lang, 'a11y.crumb')}><a href={u(route(lang, 'home'))}>{t(lang, 'crumb.home')}</a><span>/</span><span>{c.title}</span></nav>
      <h1 class="reveal">{c.title}</h1>
      <p class="lead reveal" style="--d:100ms; max-width:48rem">{c.lead}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="steps">
        {c.steps.map(([h, d], i) => (<article class="step reveal" style={`--d:${i * 90}ms`}><h3>{h}</h3><p>{d}</p></article>))}
      </div>
      <div class="notice reveal" style="margin-top:var(--space-l)"><Icon name="info" /><p><b>{c.status}:</b> {c.statusD}</p></div>
    </div>
  </section>
  <section class="section sand-bg">
    <div class="container split" style="align-items:start">
      <div class="prose reveal">
        <h2>{c.h2}</h2>
        <ul>{c.docs.map((d) => (<li>{d}</li>))}</ul>
      </div>
      <div class="prose reveal" style="--d:100ms">
        <h2>{c.h3}</h2>
        <p>{c.p3}</p>
      </div>
    </div>
  </section>
</Base>
