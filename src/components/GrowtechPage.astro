---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { t, route, routePaths, MAIL, type Lang } from '../i18n/ui';
import { u } from '../lib/url';
interface Props { lang: Lang }
const { lang } = Astro.props;
const paths = routePaths('growtech');
const title = 'Growtech Antalya 2026';
const content = {
  tr: {
    lead: 'Growtech Antalya 24–27 Kasım 2026’da ANFAŞ Expo Center’da düzenleniyor. Ligno OÜ ve AgriPak Kimya ile 3-H130 numaralı stantta görüşmek için bize ulaşın.',
    h1: 'Stantta Neler Konuşabiliriz',
    items: [
      ['Ürünleri Tanıma', 'Ligno OÜ portföyünü ve Türkiye pazarına hazırlanan ilk ürünleri birlikte ele alalım.'],
      ['Ekiple Görüşme', 'Stantta Ligno OÜ ve AgriPak Kimya temsilcileriyle iş birliği konularını görüşebilirsiniz.'],
      ['Teknik Sorular', 'İlgilendiğiniz ürünleri önceden bildirirseniz mevcut belgeleri hazır bulunduralım.'],
      ['Bayilik İş Birliği', 'Türkiye pazarı için olası iş birliği modellerini konuşalım. Görüşme saatini önceden kararlaştırmak en iyisi.'],
    ],
    h2: 'Pratik Bilgiler',
    info: [['Tarih', '24–27 Kasım 2026'], ['Yer', 'ANFAŞ Expo Center, Antalya'], ['Stant', '3-H130'], ['Randevu', 'sales@agripak.pro · +90 530 633 75 27']],
    cta: 'Görüşme Talep Edin',
  },
  en: {
    lead: 'Growtech Antalya takes place at ANFAŞ Expo Center on 24–27 November 2026. Contact us to arrange a meeting with Ligno OÜ and AgriPak Kimya at stand 3-H130.',
    h1: 'What We Can Discuss at the Stand',
    items: [
      ['Getting to Know the Products', 'Let us go through the Ligno OÜ portfolio and the first products being prepared for the Turkish market.'],
      ['Meeting the Team', 'Cooperation topics can be discussed with representatives of Ligno OÜ and AgriPak Kimya at the stand.'],
      ['Technical Questions', 'Let us know in advance which products interest you so that we can have the available documentation ready.'],
      ['Distribution Partnership', 'Let us discuss possible cooperation models for the Turkish market. It is best to agree on a meeting time in advance.'],
    ],
    h2: 'Practical Information',
    info: [['Dates', '24–27 November 2026'], ['Venue', 'ANFAŞ Expo Center, Antalya'], ['Stand', '3-H130'], ['Appointments', 'sales@agripak.pro · +90 530 633 75 27']],
    cta: 'Request a Meeting',
  },
  ru: {
    lead: 'Выставка Growtech Antalya пройдёт 24–27 ноября 2026 года в ANFAŞ Expo Center. Свяжитесь с нами, чтобы договориться о встрече с Ligno OÜ и AgriPak Kimya на стенде 3-H130.',
    h1: 'Что можно обсудить на стенде',
    items: [
      ['Знакомство с продукцией', 'Обсудим ассортимент Ligno OÜ и подготовку первых продуктов к выходу на рынок Турции.'],
      ['Встреча с командой', 'На стенде можно будет обсудить вопросы сотрудничества с представителями Ligno OÜ и AgriPak Kimya.'],
      ['Технические вопросы', 'Сообщите заранее, какие продукты вас интересуют, чтобы мы могли подготовить доступную документацию.'],
      ['Дилерское сотрудничество', 'Обсудим возможные форматы сотрудничества на турецком рынке. О времени встречи лучше договориться заранее.'],
    ],
    h2: 'Практическая информация',
    info: [['Даты', '24–27 ноября 2026'], ['Место', 'ANFAŞ Expo Center, Анталия'], ['Стенд', '3-H130'], ['Встречи', 'sales@agripak.pro · +90 530 633 75 27']],
    cta: 'Договориться о встрече',
  },
} as const;
const c = content[lang];
const mailto = `mailto:${MAIL}?subject=${encodeURIComponent(t(lang, 'contact.subject.growtech'))}`;
---
<Base lang={lang} title={title} description={c.lead} paths={paths} current="growtech">
  <section class="hero hero-event">
    <div class="hero-media">
      <picture><source srcset={u('img/photo/greenhouse_pepper.webp')} type="image/webp" /><img src={u('img/photo/greenhouse_pepper.jpg')} alt="" width="1536" height="864" fetchpriority="high" /></picture>
    </div>
    <div class="container hero-inner">
      <span class="hero-badge reveal"><i>3-H130</i><span>{t(lang, 'gt.date')}</span></span>
      <h1 class="reveal" style="--d:120ms; font-size:var(--step-4)">{title}</h1>
      <p class="lead reveal" style="--d:220ms">{c.lead}</p>
      <div class="hero-actions reveal" style="--d:320ms"><a class="btn btn-primary has-arrow" href={mailto}>{c.cta}<Icon name="arrow" /></a></div>
    </div>
    <span class="img-tag">{t(lang, 'img.illustrative')}</span>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head reveal"><h2>{c.h1}</h2></div>
      <div class="grid grid-2 topic-grid">
        {c.items.map(([h, d], i) => (<article class="card reveal" style={`--d:${i * 80}ms`}><span class="icon"><Icon name={['leaf', 'phone', 'doc', 'globe'][i]} /></span><h3>{h}</h3><p>{d}</p></article>))}
      </div>
    </div>
  </section>
  <section class="section sand-bg">
    <div class="container split" style="align-items:start">
      <div class="prose reveal">
        <h2>{c.h2}</h2>
        <table class="spec" style="background:#fff"><tbody>{c.info.map(([k, v]) => (<tr><th scope="row">{k}</th><td>{v}</td></tr>))}</tbody></table>
      </div>
      <div class="media wide reveal-scale">
        <picture><source srcset={u('img/photo/aerial_antalya.webp')} type="image/webp" /><img src={u('img/photo/aerial_antalya.jpg')} alt={t(lang, 'img.illustrative')} width="1536" height="864" loading="lazy" /></picture>
        <span class="caption">{t(lang, 'img.illustrative')}</span>
      </div>
    </div>
  </section>
</Base>
