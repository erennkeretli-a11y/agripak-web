---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { t, route, type Lang } from '../i18n/ui';
import { products, productUrl, productPaths, type Product } from '../data/products';
import { u } from '../lib/url';
interface Props { lang: Lang; product: Product }
const { lang, product: p } = Astro.props;
const paths = productPaths(p);
const related = products.filter((x) => x !== p).slice(0, 3);
const formLabel = p.formShort[lang];
const docs = ['prod.tds', 'prod.sds', 'prod.coa', 'prod.label'] as const;
---
<Base lang={lang} title={`${p.name} · ${formLabel}`} description={p.intro[lang]} paths={paths} current="products">
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={u(route(lang, 'home'))}>{t(lang, 'crumb.home')}</a><span>/</span>
        <a href={u(route(lang, 'products'))}>{t(lang, 'nav.products')}</a><span>/</span><span>{p.name}</span>
      </nav>
      <div class="split" style="align-items:center">
        <div class="grid" style="gap:var(--space-s)">
          <span class="eyebrow reveal">{p.category[lang]}</span>
          <h1 class="reveal" style="--d:80ms">{p.name} <span class="muted" style="font-weight:500">{formLabel}</span></h1>
          <p class="lead reveal" style="--d:160ms">{p.tagline[lang]}</p>
          {p.active && <p class="reveal" style="--d:220ms; font-weight:700; color:var(--teal-deep)">{p.active[lang]}</p>}
          <div class="hero-actions reveal" style="--d:280ms">
            <a class="btn btn-primary" href={u(route(lang, 'contact'))}>{t(lang, 'prod.request')}<Icon name="arrow" /></a>
            <a class="btn btn-ghost" style="color:var(--ink)" href="https://wa.me/905306337527" target="_blank" rel="noopener"><Icon name="wa" />WhatsApp</a>
          </div>
        </div>
        <div class="pshot reveal-scale">
          <span class="orb"></span>
          <img src={u(p.image)} alt={p.name} width="400" height="600" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container detail">
      <div class="prose">
        <p class="lead">{p.intro[lang]}</p>
        <h2>{t(lang, 'prod.benefits')}</h2>
        <ul class="benefits" role="list">
          {p.benefits.map((b) => (<li><Icon name="check" />{b[lang]}</li>))}
        </ul>
        <h2>{t(lang, 'prod.apps')}</h2>
        <div class="table-wrap">
          <table class="spec apps">
            <thead><tr><th>{t(lang, 'prod.method')}</th><th>{t(lang, 'prod.dose')}</th><th>{t(lang, 'prod.note')}</th></tr></thead>
            <tbody>
              {p.apps.map((a) => (<tr><td>{a.method[lang]}</td><td>{a.dose[lang]}</td><td class="muted" style="font-weight:500">{a.note?.[lang] ?? ''}</td></tr>))}
            </tbody>
          </table>
        </div>
        <div class="notice"><Icon name="info" /><p><b>{t(lang, 'prod.status')}:</b> {t(lang, 'prod.notice')}</p></div>
      </div>
      <aside class="grid" style="gap:var(--space-m); align-content:start">
        <div class="card">
          <h3>{t(lang, 'prod.specs')}</h3>
          <table class="spec">
            <tbody>
              <tr><th>{t(lang, 'prod.manufacturer')}</th><td>Ligno OÜ, Tallinn</td></tr>
              <tr><th>{t(lang, 'prod.form')}</th><td>{p.form[lang]}</td></tr>
              {p.specs.map((s) => (<tr><th>{s.k[lang]}</th><td>{s.v[lang]}</td></tr>))}
              <tr><th>{t(lang, 'prod.pack')}</th><td>{p.pack[lang]}</td></tr>
            </tbody>
          </table>
        </div>
        <div class="card">
          <h3>{t(lang, 'prod.downloads')}</h3>
          <ul class="docs" role="list">
            {docs.map((d) => (<li><a href="#"><Icon name="doc" />{t(lang, d)}<span class="muted">PDF</span></a></li>))}
          </ul>
        </div>
        <div class="card" style="background:var(--sand)">
          <img src={u('img/brand/igrow-logo.svg')} alt="iGrow" width="120" height="110" style="height:4.5rem; width:auto" />
          <p>{t(lang, 'prod.brand')}</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section sand-bg">
    <div class="container">
      <div class="section-head reveal"><span class="eyebrow">{t(lang, 'prod.related')}</span></div>
      <div class="grid grid-3">
        {related.map((r) => (
          <a class="pcard reveal" href={u(productUrl(lang, r))}>
            <span class={`tag ${r.status === 'soon' ? 'soon' : ''}`}>{r.status === 'first' ? t(lang, 'port.first') : t(lang, 'port.soon')}</span>
            <div class="pcard-media"><img src={u(r.image)} alt={r.name} loading="lazy" decoding="async" /></div>
            <div class="pcard-body"><h3>{r.name}</h3><p>{r.short[lang]}</p><span class="link">{t(lang, 'port.detail')}<Icon name="arrow" /></span></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
