---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import ContactActions from './ContactActions.astro';
import { t, route, type Lang } from '../i18n/ui';
import { products, productUrl, productPaths, type Product } from '../data/products';
import { u } from '../lib/url';
interface Props { lang: Lang; product: Product }
const { lang, product: p } = Astro.props;
const paths = productPaths(p);
const related = products.filter((x) => x !== p && x.status === 'portfolio').slice(0, 3);
const formLabel = p.formShort[lang];
const statusKey = p.status === 'prep' ? 'prod.status.prep' : 'prod.status.portfolio';
const tagKey = p.status === 'prep' ? 'status.prep' : 'status.portfolio';
const subject = `${t(lang, 'contact.subject.product')}: ${p.name} ${formLabel}`;
const waText = `${t(lang, 'contact.subject.product')}: ${p.name} ${formLabel}`;
---
<Base lang={lang} title={`${p.name} · ${formLabel}`} description={p.seo[lang]} paths={paths} current="products">
  <section class="page-hero product-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={t(lang, 'a11y.crumb')}>
        <a href={u(route(lang, 'home'))}>{t(lang, 'crumb.home')}</a><span>/</span>
        <a href={u(route(lang, 'products'))}>{t(lang, 'nav.products')}</a><span>/</span><span>{p.name}</span>
      </nav>
      <div class="split" style="align-items:center">
        <div class="grid" style="gap:var(--space-s)">
          <span class={`tag ${p.status} reveal`} style="position:static; width:max-content">{t(lang, tagKey)}</span>
          <h1 class="reveal" style="--d:80ms">{p.name} <span class="muted" style="font-weight:500">{formLabel}</span></h1>
          <p class="lead reveal" style="--d:160ms">{p.tagline[lang]}</p>
          {p.active && <p class="reveal" style="--d:220ms; font-weight:700; color:var(--teal-deep)">{p.active[lang]}</p>}
          <p class="muted reveal" style="--d:260ms; font-size:var(--step--1)">{t(lang, statusKey)}</p>
          <div class="reveal" style="--d:300ms"><ContactActions lang={lang} subject={subject} waText={waText} /></div>
        </div>
        <div class="pshot reveal-scale">
          <span class="orb"></span>
          <img src={u(p.image)} alt={`${p.name} ${formLabel}`} width="400" height="600" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container detail">
      <div class="prose">
        <p class="lead">{p.intro[lang]}</p>
        <h2>{t(lang, 'prod.benefits')}</h2>
        <ul class="benefits" role="list">
          {p.benefits.map((b) => (<li><Icon name="check" />{b[lang]}</li>))}
        </ul>
        <h2>{t(lang, 'prod.apps')}</h2>
        <div class="table-wrap">
          <table class="spec apps">
            <thead><tr><th scope="col">{t(lang, 'prod.method')}</th><th scope="col">{t(lang, 'prod.dose')}</th></tr></thead>
            <tbody>
              {p.apps.map((a) => (<tr><td>{a.method[lang]}</td><td style="font-weight:500">{a.info[lang]}</td></tr>))}
            </tbody>
          </table>
        </div>
        <div class="notice"><Icon name="info" /><p>{t(lang, 'prod.apps.note')}</p></div>
        {p.organicCert && <div class="notice"><Icon name="leaf" /><p>{t(lang, 'prod.organic')}</p></div>}
      </div>
      <aside class="grid" style="gap:var(--space-m); align-content:start">
        <div class="card">
          <h3>{t(lang, 'prod.specs')}</h3>
          <table class="spec">
            <tbody>
              <tr><th scope="row">{t(lang, 'prod.manufacturer')}</th><td>Ligno OÜ, {lang === 'ru' ? 'Эстония' : lang === 'en' ? 'Estonia' : 'Estonya'}</td></tr>
              <tr><th scope="row">{t(lang, 'prod.form')}</th><td>{p.form[lang]}</td></tr>
              {p.specs.map((s) => (<tr><th scope="row">{s.k[lang]}</th><td>{s.v[lang]}</td></tr>))}
              <tr><th scope="row">{t(lang, 'prod.pack')}</th><td>{p.pack[lang]}</td></tr>
              <tr><th scope="row">{t(lang, 'prod.source')}</th><td style="font-weight:500">{t(lang, 'prod.source.v')}</td></tr>
            </tbody>
          </table>
        </div>
        <div class="card">
          <h3>{t(lang, 'prod.docs')}</h3>
          <p>{t(lang, 'prod.docs.note')}</p>
          <div><a class="btn btn-dark" href={`mailto:sales@agripak.pro?subject=${encodeURIComponent(subject)}`}><Icon name="doc" />{t(lang, 'prod.request')}</a></div>
        </div>
        <div class="card" style="background:var(--sand)">
          <img src={u('img/brand/igrow-logo.svg')} alt="iGrow" width="120" height="110" style="height:4.5rem; width:auto" />
          <p>{t(lang, 'prod.brand')}</p>
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section sand-bg">
      <div class="container">
        <div class="section-head related-head reveal"><h2>{t(lang, 'prod.related')}</h2><a class="text-link" href={u(route(lang, 'products'))}>{t(lang, 'show.all')}<Icon name="arrow" /></a></div>
        <div class="grid grid-3 related-grid">
          {related.map((r) => (
            <a class="pcard reveal" href={u(productUrl(lang, r))}>
              <div class="pcard-media"><img src={u(r.image)} alt={r.name} loading="lazy" decoding="async" /></div>
              <div class="pcard-body"><span class={`tag ${r.status}`}>{t(lang, r.status === 'prep' ? 'status.prep' : 'status.portfolio')}</span><h3>{r.name}</h3><p>{r.short[lang]}</p><span class="link">{t(lang, 'port.detail')}<Icon name="arrow" /></span></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
