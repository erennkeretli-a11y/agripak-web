---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import ContactActions from './ContactActions.astro';
import { t, route, routePaths, PHONE, PHONE_TEL, MAIL, type Lang } from '../i18n/ui';
import { u } from '../lib/url';
interface Props { lang: Lang }
const { lang } = Astro.props;
const paths = routePaths('contact');
const title = t(lang, 'nav.contact');
const mapSrc = `https://www.google.com/maps?q=36.86123,30.78224&z=16&hl=${lang}&output=embed`;
---
<Base lang={lang} title={title} description={t(lang, 'contact.lead')} paths={paths} current="contact">
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={t(lang, 'a11y.crumb')}><a href={u(route(lang, 'home'))}>{t(lang, 'crumb.home')}</a><span>/</span><span>{title}</span></nav>
      <h1 class="reveal">{t(lang, 'contact.title')}</h1>
      <p class="lead reveal" style="--d:100ms; max-width:48rem">{t(lang, 'contact.lead')}</p>
      <div class="reveal" style="--d:180ms; margin-top:var(--space-m)"><ContactActions lang={lang} subject={t(lang, 'contact.subject.product')} /></div>
    </div>
  </section>
  <section class="section">
    <div class="container split" style="align-items:start">
      <div class="grid" style="gap:var(--space-s)">
        <div class="contact-card reveal"><small>{t(lang, 'contact.phone.l')}</small><a href={PHONE_TEL}>{PHONE}</a></div>
        <div class="contact-card reveal" style="--d:60ms"><small>{t(lang, 'contact.mail.l')}</small><a href={`mailto:${MAIL}`}>{MAIL}</a></div>
        <div class="contact-card reveal" style="--d:120ms"><small>{t(lang, 'contact.addr.l')}</small><span>AgriPak Kimya A.Ş.<br />Güzeloba Mah. Çağlayangil Cad. No: 3B<br />{t(lang, 'footer.country')}</span><span class="muted" style="font-size:var(--step--1)">{t(lang, 'contact.addr.note')}</span></div>
        <div class="notice reveal" style="--d:180ms"><Icon name="info" /><p>{t(lang, 'contact.form.note')} <a href={u(route(lang, 'legal'))} style="font-weight:700; text-decoration:underline">{t(lang, 'contact.kvkk')}</a></p></div>
      </div>
      <div class="grid" style="gap:var(--space-s)">
        <div class="media wide map-box reveal-scale" data-map data-src={mapSrc}>
          <div class="map-placeholder">
            <Icon name="pin" />
            <strong>{t(lang, 'map.title')}</strong>
            <span class="muted" style="font-size:var(--step--1)">{t(lang, 'map.note')}</span>
            <button class="btn btn-dark" type="button" data-map-load>{t(lang, 'map.load')}</button>
          </div>
        </div>
        <div class="hero-actions">
          <a class="btn btn-ghost" style="color:var(--ink)" href="https://www.google.com/maps/search/?api=1&query=36.86123,30.78224" target="_blank" rel="noopener"><Icon name="pin" />{t(lang, 'map.google')}</a>
          <a class="btn btn-ghost" style="color:var(--ink)" href="https://yandex.com/maps/?pt=30.78224,36.86123&z=16&l=map" target="_blank" rel="noopener"><Icon name="pin" />{t(lang, 'map.yandex')}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((box) => {
    box.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = box.dataset.src ?? ''; f.title = box.querySelector('strong')?.textContent ?? 'Map';
      f.setAttribute('style', 'width:100%;height:100%;border:0;min-height:18rem'); f.setAttribute('loading', 'lazy'); f.setAttribute('referrerpolicy', 'no-referrer-when-downgrade'); f.setAttribute('allowfullscreen', '');
      box.replaceChildren(f);
    });
  });
</script>
