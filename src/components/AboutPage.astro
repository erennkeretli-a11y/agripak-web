---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { t, route, routePaths, type Lang } from '../i18n/ui';
import { u } from '../lib/url';
interface Props { lang: Lang }
const { lang } = Astro.props;
const paths = routePaths('about');
const content = {
  tr: {
    title: 'Hakkımızda',
    lead: 'AgriPak Kimya, Estonyalı üretici Ligno OÜ’nün iGrow ürünlerini Türkiye pazarına hazırlayan Antalya merkezli bir distribütörlük şirketidir.',
    h1: 'Antalya’dan Türkiye pazarına',
    p1: 'AgriPak Kimya A.Ş. 2023’te Ankara’da kuruldu ve 2026’da merkezini Antalya’nın Muratpaşa ilçesine taşıdı. Şirket, Ligno OÜ ile Türkiye pazarı için çalışıyor.',
    p2: 'Şu anda şirket lisansının alınmasına, ürün tescili için gerekli belgelerin hazırlanmasına ve ithalatın planlanmasına odaklanıyoruz. Sevkiyat ve teknik destek bilgileri hazır oldukça güncellenecektir. Amacımız, Ligno OÜ ürünlerini gerekli lisans, tescil ve ithalat süreçlerini tamamlayarak Türkiye pazarına sunmak.',
    h2: 'Ligno OÜ ile çalışma',
    p3: 'Ligno OÜ, 2014’te kurulmuş Estonyalı bir şirkettir. Portföyünde iGrow ve LignoGro markalı ürünler yer alır. Ürünlerin teknik belgeleri Ligno OÜ tarafından sağlanır.',
    p4: 'AgriPak Kimya, Ligno OÜ ürünlerinin Türkiye’de tescile ve ithalata hazırlanmasını koordine eder.',
    h3: 'Çalışma ilkelerimiz',
    v: [
      ['Belgeye dayalı bilgi', 'Ürün bilgilerini üretici belgelerine dayandırır, lisans ve tescil durumunu tamamlanan işlemlere göre güncelleriz.'],
      ['Kaynağı belli bilgi', 'Üretici verisini deneme sonuçlarından ayırır, her bilginin kaynağını belirtiriz.'],
      ['Doğrudan iletişim', 'Ürün ve iş birliği soruları için AgriPak Kimya’ya telefon veya e-posta ile ulaşabilirsiniz.'],
    ],
    team: 'Türkiye operasyonu ve üretici iş birliği',
    ceoT: 'CEO, AgriPak Kimya A.Ş.',
    ceoD: 'AgriPak Kimya’nın Türkiye faaliyetlerini koordine eder: tescil işlemleri, gümrük temsilcisiyle iletişim ve Growtech hazırlıkları.',
    partnerT: 'Üretici iş ortağı, Estonya',
    partnerD: 'Ürün geliştirme, üretim, teknik belgeler ve ihracat lojistiği.',
  },
  en: {
    title: 'About us',
    lead: 'AgriPak Kimya is an Antalya-based distribution company preparing the iGrow products of the Estonian manufacturer Ligno OÜ for the Turkish market.',
    h1: 'From Antalya to the Turkish market',
    p1: 'AgriPak Kimya A.Ş. was established in Ankara in 2023 and moved its registered office to Muratpaşa, Antalya, in 2026. The company works with Ligno OÜ for the Turkish market.',
    p2: 'The current focus is on the company licence, the preparation of registration documents and the organisation of imports. Information on deliveries and technical support will be updated as it becomes available. Our aim is to introduce Ligno OÜ products to the Turkish market after completing the required licensing, registration and import procedures.',
    h2: 'Working with Ligno OÜ',
    p3: 'Ligno OÜ is an Estonian company founded in 2014. Its portfolio includes products under the iGrow and LignoGro brands. Product documentation is supplied by Ligno OÜ.',
    p4: 'AgriPak Kimya coordinates the preparation of Ligno OÜ products for registration and import in Türkiye.',
    h3: 'How we work',
    v: [
      ['Documented information', 'We base product information on manufacturer documentation and update licensing and registration status as the relevant procedures are completed.'],
      ['Sourced information', 'We separate manufacturer data from trial results and state the source of each piece of information.'],
      ['Direct contact', 'For product and cooperation enquiries you can reach AgriPak Kimya by phone or email.'],
    ],
    team: 'Türkiye operations and manufacturing partnership',
    ceoT: 'CEO, AgriPak Kimya A.Ş.',
    ceoD: 'Coordinates AgriPak Kimya’s activities in Türkiye, including registration procedures, liaison with the customs representative and Growtech preparations.',
    partnerT: 'Manufacturing partner, Estonia',
    partnerD: 'Product development, production, technical documentation and export logistics.',
  },
  ru: {
    title: 'О компании',
    lead: 'AgriPak Kimya представляет продукцию Ligno OÜ на турецком рынке. Компания зарегистрирована в Анталии и координирует подготовку продукции к регистрации и импорту.',
    h1: 'Работа с турецким рынком из Анталии',
    p1: 'AgriPak Kimya основана в Анкаре в 2023 году. В 2026 году компания перенесла юридический адрес в район Муратпаша в Анталии и продолжает работу с Ligno OÜ на турецком рынке.',
    p2: 'Сейчас основное внимание уделяется лицензированию, подготовке регистрационных документов и организации импорта. Сведения о поставках и техническом сопровождении будут обновляться по мере готовности. Наша цель — вывести продукцию Ligno OÜ на рынок Турции после завершения необходимых процедур лицензирования, регистрации и импорта.',
    h2: 'Сотрудничество с Ligno OÜ',
    p3: 'Ligno OÜ — эстонская компания, основанная в 2014 году. В её ассортимент входят продукты под брендами iGrow и LignoGro. Техническую документацию на продукцию предоставляет Ligno OÜ.',
    p4: 'AgriPak Kimya координирует подготовку продукции Ligno OÜ к регистрации и импорту в Турцию.',
    h3: 'Принципы работы',
    v: [
      ['Информация на основе документов', 'Информацию о продукции мы приводим по документам производителя, а сведения о лицензировании и регистрации обновляем по мере завершения соответствующих процедур.'],
      ['Точные сведения', 'Мы отделяем данные производителя от результатов испытаний и указываем источник информации.'],
      ['Прямой контакт', 'По вопросам продукции и сотрудничества можно связаться с AgriPak Kimya по телефону или электронной почте.'],
    ],
    team: 'Работа в Турции и сотрудничество с производителем',
    ceoT: 'CEO, AgriPak Kimya A.Ş.',
    ceoD: 'Координирует деятельность AgriPak Kimya в Турции, включая регистрационные процедуры, взаимодействие с таможенным представителем и подготовку к Growtech.',
    partnerT: 'Партнёр по продукции, Эстония',
    partnerD: 'Разработка продуктов, производство, техническая документация и экспортная логистика.',
  },
} as const;
const c = content[lang];
---
<Base lang={lang} title={c.title} description={c.lead} paths={paths} current="about">
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={t(lang, 'a11y.crumb')}><a href={u(route(lang, 'home'))}>{t(lang, 'crumb.home')}</a><span>/</span><span>{c.title}</span></nav>
      <h1 class="reveal">{c.title}</h1>
      <p class="lead reveal" style="--d:100ms; max-width:48rem">{c.lead}</p>
    </div>
  </section>
  <section class="section">
    <div class="container split" style="align-items:start">
      <div class="prose reveal">
        <h2>{c.h1}</h2>
        <p>{c.p1}</p>
        <p>{c.p2}</p>
      </div>
      <div class="media tall reveal-scale">
        <picture><source srcset={u('img/photo/citrus_leaves.webp')} type="image/webp" /><img src={u('img/photo/citrus_leaves.jpg')} alt={t(lang, 'img.illustrative')} width="1344" height="896" loading="lazy" /></picture>
        <span class="caption">{t(lang, 'img.illustrative')}</span>
      </div>
    </div>
  </section>
  <section class="section sand-bg">
    <div class="container split" style="align-items:start">
      <div class="card reveal" style="padding:var(--space-l); display:grid; place-items:center; background:#fff">
        <img src={u('img/brand/igrow-logo.svg')} alt="iGrow, Ligno OÜ" style="height:7rem; width:auto" />
      </div>
      <div class="prose reveal" style="--d:100ms">
        <h2>{c.h2}</h2>
        <p>{c.p3}</p>
        <p>{c.p4}</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head reveal"><span class="eyebrow">{c.h3}</span></div>
      <div class="grid grid-3">
        {c.v.map(([h, d], i) => (<article class="card reveal" style={`--d:${i * 90}ms`}><span class="icon"><Icon name={['stamp', 'lab', 'phone'][i]} /></span><h3>{h}</h3><p>{d}</p></article>))}
      </div>
      <div class="section-head reveal" style="margin-top:var(--space-2xl)"><span class="eyebrow">{c.team}</span></div>
      <div class="grid grid-2">
        <article class="card reveal"><h3>Eren Keretli</h3><p style="font-weight:700; color:var(--teal-deep)">{c.ceoT}</p><p>{c.ceoD}</p><p><a href="mailto:erengm@agripak.pro" style="font-weight:700">erengm@agripak.pro</a></p></article>
        <article class="card reveal" style="--d:90ms"><h3>Ligno OÜ</h3><p style="font-weight:700; color:var(--teal-deep)">{c.partnerT}</p><p>{c.partnerD}</p><p><a href="https://ligno.ee" target="_blank" rel="noopener" style="font-weight:700">ligno.ee</a></p></article>
      </div>
    </div>
  </section>
</Base>
