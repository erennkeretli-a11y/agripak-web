---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import ContactActions from './ContactActions.astro';
import { t, route, routePaths, PHONE, PHONE_TEL, MAIL, type Lang } from '../i18n/ui';
import { products, productUrl } from '../data/products';
import { u } from '../lib/url';
interface Props { lang: Lang }
const { lang } = Astro.props;
const paths = routePaths('home');
const first = products.filter((p) => p.status === 'prep');
const rest = products.filter((p) => p.status === 'portfolio');
const why = [
  { icon: 'root', t: t(lang, 'why.1.t'), d: t(lang, 'why.1.d') },
  { icon: 'drop', t: t(lang, 'why.2.t'), d: t(lang, 'why.2.d') },
  { icon: 'shield', t: t(lang, 'why.3.t'), d: t(lang, 'why.3.d') },
  { icon: 'soil', t: t(lang, 'why.4.t'), d: t(lang, 'why.4.d') },
];
const proc = [
  { icon: 'doc', t: t(lang, 'proc.1.t'), d: t(lang, 'proc.1.d') },
  { icon: 'stamp', t: t(lang, 'proc.2.t'), d: t(lang, 'proc.2.d') },
  { icon: 'lab', t: t(lang, 'proc.3.t'), d: t(lang, 'proc.3.d') },
  { icon: 'truck', t: t(lang, 'proc.4.t'), d: t(lang, 'proc.4.d') },
];
const strip = ['strip.1', 'strip.2', 'strip.3', 'strip.4', 'strip.5'] as const;
---
<Base lang={lang} paths={paths} current="home">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-media">
      <picture>
        <source srcset={u('img/photo/hero_greenhouse.webp')} type="image/webp" />
        <img src={u('img/photo/hero_greenhouse.jpg')} alt="" width="1792" height="896" fetchpriority="high" decoding="async" />
      </picture>
    </div>
    <div class="container hero-inner">
      <span class="hero-badge reveal"><i><Icon name="calendar" /></i><span>{t(lang, 'hero.badge')}</span></span>
      <span class="eyebrow on-dark reveal" style="--d:80ms">{t(lang, 'hero.eyebrow')}</span>
      <h1 class="reveal" style="--d:160ms" set:html={t(lang, 'hero.title')} />
      <p class="lead reveal" style="--d:260ms">{t(lang, 'hero.lead')}</p>
      <div class="hero-actions reveal" style="--d:360ms">
        <a class="btn btn-primary has-arrow" href={u(route(lang, 'products'))}>{t(lang, 'hero.cta1')}<Icon name="arrow" /></a>
        <a class="btn btn-ghost" href={u(route(lang, 'contact'))}>{t(lang, 'hero.cta2')}</a>
      </div>
    </div>
    <span class="img-tag">{t(lang, 'img.illustrative')}</span>
  </section>

  <!-- INFO STRIP (static) -->
  <div class="strip">
    <ul class="container strip-list" role="list">
      <li><img src={u('img/brand/igrow-logo.svg')} alt="iGrow, Ligno OÜ" width="60" height="55" /></li>
      {strip.map((k) => (<li><span class="dot"></span>{t(lang, k)}</li>))}
    </ul>
  </div>

  <!-- FIRST PRODUCTS (sticky showcase on desktop) -->
  <section class="section sand-bg">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t(lang, 'show.eyebrow')}<span class="section-index" aria-hidden="true">01</span></span>
        <h2>{t(lang, 'show.title')}</h2>
        <p class="lead">{t(lang, 'show.lead')}</p>
      </div>
      <div class="showcase">
        <div class="showcase-steps">
          {first.map((p, i) => (
            <article class="showcase-step">
              <img class="showcase-inline" src={u(p.image)} alt="" loading="lazy" decoding="async" />
              <span class="tag prep">{t(lang, 'status.prep')}</span>
              <h3>{p.name} <span class="muted" style="font-weight:500">{p.formShort[lang]}</span></h3>
              <p class="muted">{p.intro[lang]}</p>
              <ul>
                {p.benefits.slice(0, 3).map((b) => (<li>{b[lang]}</li>))}
              </ul>
              <div style="margin-top:.5rem"><a class="btn btn-dark has-arrow" href={u(productUrl(lang, p))}>{t(lang, 'port.detail')}<Icon name="arrow" /></a></div>
            </article>
          ))}
        </div>
      </div>
      <p class="muted reveal" style="margin-top:var(--space-l); font-size:var(--step--1); max-width:60ch">{t(lang, 'prod.status.prep')}</p>
    </div>
  </section>

  <!-- COMPOSITION -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t(lang, 'why.eyebrow')}<span class="section-index" aria-hidden="true">02</span></span>
        <h2>{t(lang, 'why.title')}</h2>
        <p class="lead">{t(lang, 'why.lead')}</p>
      </div>
      <div class="grid grid-4">
        {why.map((w, i) => (
          <article class="card reveal" style={`--d:${i * 90}ms`}>
            <span class="icon"><Icon name={w.icon} /></span>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </article>
        ))}
      </div>
      <div class="notice reveal" style="margin-top:var(--space-m)"><Icon name="info" /><p>{t(lang, 'why.note')}</p></div>
    </div>
  </section>

  <!-- PORTFOLIO (compact list) -->
  <section class="section sand-bg">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t(lang, 'port.eyebrow')}<span class="section-index" aria-hidden="true">03</span></span>
        <h2>{t(lang, 'port.title')}</h2>
        <p class="lead">{t(lang, 'port.lead')}</p>
      </div>
      <ul class="plist reveal" role="list">
        {rest.map((p) => (
          <li>
            <a href={u(productUrl(lang, p))}>
              <img src={u(p.image)} alt="" loading="lazy" decoding="async" />
              <span class="plist-text"><b>{p.name}</b><span class="muted">{p.short[lang]}</span></span>
              <span class="tag portfolio">{t(lang, 'status.portfolio')}</span>
              <Icon name="arrow" />
            </a>
          </li>
        ))}
      </ul>
      <div style="margin-top:var(--space-m)"><a class="btn btn-ghost has-arrow" style="color:var(--ink)" href={u(route(lang, 'products'))}>{t(lang, 'show.all')}<Icon name="arrow" /></a></div>
    </div>
  </section>

  <!-- PREPARATION -->
  <section class="section dark">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow on-dark">{t(lang, 'proc.eyebrow')}<span class="section-index" aria-hidden="true">04</span></span>
        <h2 style="color:#fff">{t(lang, 'proc.title')}</h2>
      </div>
      <div class="steps">
        {proc.map((s, i) => (
          <article class="step reveal" style={`--d:${i * 100}ms; background:rgba(255,255,255,.05)`}>
            <span class="icon" style="color:var(--leaf)"><Icon name={s.icon} /></span>
            <h3 style="color:#fff">{s.t}</h3>
            <p>{s.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT / FACTS -->
  <section class="section">
    <div class="container split">
      <div class="media wide reveal-scale">
        <picture>
          <source srcset={u('img/photo/aerial_antalya.webp')} type="image/webp" />
          <img src={u('img/photo/aerial_antalya.jpg')} alt={t(lang, 'img.illustrative')} width="1536" height="864" loading="lazy" decoding="async" />
        </picture>
        <span class="caption">{t(lang, 'img.illustrative')}</span>
      </div>
      <div>
        <div class="section-head reveal">
          <span class="eyebrow">{t(lang, 'about.eyebrow')}<span class="section-index" aria-hidden="true">05</span></span>
          <h2>{t(lang, 'about.title')}</h2>
          <p class="lead">{t(lang, 'about.lead')}</p>
          <div><a class="btn btn-dark has-arrow" href={u(route(lang, 'about'))}>{t(lang, 'about.cta')}<Icon name="arrow" /></a></div>
        </div>
        <div class="stats reveal">
          <div class="stat"><b>{t(lang, 'stat.1.b')}</b><span>{t(lang, 'stat.1.s')}</span></div>
          <div class="stat"><b>{t(lang, 'stat.2.b')}</b><span>{t(lang, 'stat.2.s')}</span></div>
          <div class="stat"><b>{t(lang, 'stat.3.b')}</b><span>{t(lang, 'stat.3.s')}</span></div>
          <div class="stat"><b>{t(lang, 'stat.4.b')}</b><span>{t(lang, 'stat.4.s')}</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- GROWTECH -->
  <section class="section-tight">
    <div class="container">
      <div class="cta-band reveal-scale">
        <div class="bgimg">
          <picture>
            <source srcset={u('img/photo/dark_soil_texture.webp')} type="image/webp" />
            <img src={u('img/photo/dark_soil_texture.jpg')} alt="" width="1792" height="896" loading="lazy" decoding="async" />
          </picture>
        </div>
        <div class="grid" style="gap:var(--space-s); max-width:44rem">
          <span class="date"><Icon name="calendar" /> {t(lang, 'gt.date')}<span class="section-index" aria-hidden="true">06</span></span>
          <h2>{t(lang, 'gt.title')}</h2>
          <p class="lead" style="color:rgba(255,255,255,.8)">{t(lang, 'gt.lead')}</p>
          <div class="hero-actions" style="margin-top:.5rem">
            <a class="btn btn-primary has-arrow" href={`mailto:${MAIL}?subject=${encodeURIComponent(t(lang, 'contact.subject.growtech'))}`}>{t(lang, 'gt.cta')}<Icon name="arrow" /></a>
            <a class="btn btn-ghost" href={u(route(lang, 'growtech'))}>{t(lang, 'gt.cta2')}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section" id="contact">
    <div class="container split" style="align-items:start">
      <div class="section-head reveal">
        <span class="eyebrow">{t(lang, 'contact.eyebrow')}<span class="section-index" aria-hidden="true">07</span></span>
        <h2>{t(lang, 'contact.title')}</h2>
        <p class="lead">{t(lang, 'contact.lead')}</p>
        <ContactActions lang={lang} subject={t(lang, 'contact.subject.product')} />
      </div>
      <div class="grid grid-2 reveal" style="--d:120ms">
        <div class="contact-card"><small>{t(lang, 'contact.phone.l')}</small><a href={PHONE_TEL}>{PHONE}</a></div>
        <div class="contact-card"><small>{t(lang, 'contact.mail.l')}</small><a href={`mailto:${MAIL}`}>{MAIL}</a></div>
        <div class="contact-card" style="grid-column:1/-1"><small>{t(lang, 'contact.addr.l')}</small><span>Güzeloba Mah. Çağlayangil Cad. No: 3B, {t(lang, 'footer.country')}</span><span class="muted" style="font-size:var(--step--1)">{t(lang, 'contact.addr.note')}</span></div>
      </div>
    </div>
  </section>
</Base>
