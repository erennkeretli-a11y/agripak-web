---
import { t, route, langs, langNames, WA, type Lang, type Paths } from '../i18n/ui';
import { u } from '../lib/url';
import Icon from './Icon.astro';
interface Props { lang: Lang; paths: Paths; current?: string }
const { lang, paths, current } = Astro.props;
const nav = [
  ['products', t(lang, 'nav.products')],
  ['about', t(lang, 'nav.about')],
  ['quality', t(lang, 'nav.quality')],
  ['growtech', t(lang, 'nav.growtech')],
  ['contact', t(lang, 'nav.contact')],
] as const;
---
<a class="skip" href="#main">{t(lang, 'a11y.skip')}</a>
<header class="site-header" id="top">
  <div class="container bar">
    <a class="brand" href={u(route(lang, 'home'))} aria-label="AgriPak Kimya">
      <img src={u('img/brand/agripak-logo-a.svg')} alt="AgriPak Kimya" width="135" height="60" class="brand-logo" />
    </a>
    <nav class="nav" aria-label={t(lang, 'a11y.nav')}>
      {nav.map(([key, label]) => (
        <a href={u(route(lang, key))} aria-current={current === key ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <div class="lang" role="group" aria-label={t(lang, 'a11y.lang')}>
        {langs.map((l) => (
          <a href={u(paths[l])} aria-current={l === lang ? 'true' : undefined} lang={l} hreflang={l} aria-label={langNames[l]} title={langNames[l]}>{l.toUpperCase()}</a>
        ))}
      </div>
      <a class="btn btn-dark" href={WA} target="_blank" rel="noopener" style="display:none" data-desktop-only><Icon name="wa" />{t(lang, 'nav.wa')}</a>
      <button class="menu-btn" aria-expanded="false" aria-controls="mobile-nav" aria-label={t(lang, 'a11y.menu')} data-menu><Icon name="menu" /></button>
    </div>
  </div>
  <nav class="container mobile-nav" id="mobile-nav" hidden aria-label={t(lang, 'a11y.nav')}>
    {nav.map(([key, label]) => (<a href={u(route(lang, key))} aria-current={current === key ? 'page' : undefined}>{label}</a>))}
    <a class="btn btn-wa" href={WA} target="_blank" rel="noopener"><Icon name="wa" />{t(lang, 'nav.wa')} · +90 530 633 75 27</a>
  </nav>
</header>
<style>
  @media (min-width: 80rem) { [data-desktop-only] { display: inline-flex !important; } }
</style>
