---
import { t, route, PHONE, PHONE_TEL, MAIL, type Lang } from '../i18n/ui';
import { products, productUrl } from '../data/products';
import { u } from '../lib/url';
interface Props { lang: Lang }
const { lang } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src={u('img/brand/agripak-logo-a.svg')} alt="AgriPak Kimya" width="180" height="80" />
        <p style="margin-top:1rem; max-width:28rem">{t(lang, 'footer.about')}</p>
      </div>
      <div>
        <h4>{t(lang, 'footer.products')}</h4>
        <ul>
          {products.map((p) => (<li><a href={u(productUrl(lang, p))}>{p.name} · {p.formShort[lang]}</a></li>))}
        </ul>
      </div>
      <div>
        <h4>{t(lang, 'footer.company')}</h4>
        <ul>
          <li><a href={u(route(lang, 'about'))}>{t(lang, 'nav.about')}</a></li>
          <li><a href={u(route(lang, 'quality'))}>{t(lang, 'nav.quality')}</a></li>
          <li><a href={u(route(lang, 'growtech'))}>{t(lang, 'nav.growtech')}</a></li>
          <li><a href={u(route(lang, 'contact'))}>{t(lang, 'nav.contact')}</a></li>
          <li><a href={u(route(lang, 'legal'))}>{t(lang, 'footer.kvkk')}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t(lang, 'footer.contact')}</h4>
        <ul>
          <li><a href={PHONE_TEL}>{PHONE}</a></li>
          <li><a href={`mailto:${MAIL}`}>{MAIL}</a></li>
          <li>Güzeloba Mah. Çağlayangil Cad. No: 3B<br />{t(lang, 'footer.country')}</li>
        </ul>
        <h4 style="margin-top:1.25rem">{t(lang, 'footer.legal')}</h4>
        <ul style="font-size:.8rem; color:#8fa5a2">
          <li>AGRİPAK KİMYA ANONİM ŞİRKETİ</li>
          <li>{t(lang, 'footer.registry')} 146543 · MERSİS 0009178097300001</li>
          <li>{t(lang, 'footer.tax')} 0091780973</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} AgriPak Kimya A.Ş. {t(lang, 'footer.rights')}</span>
      <span>{t(lang, 'footer.notice')}</span>
    </div>
  </div>
</footer>
